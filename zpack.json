{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.0.1/resources/zpack-schema.json",
  "name": "overline-zebar",
  "version": "0.0.0",
  "description": "Fully featured topbar using React+Vite, Tailwind & Framer Motion. ",
  "tags": [],
  "previewImages": [
    "resources/preview-image-1.png",
    "resources/preview-image-2.png",
    "resources/preview-image-3.png"
  ],
  "repositoryUrl": "https://github.com/mushfikurr/overline-zebar",
  "widgets": [
    {
      "name": "main",
      "htmlPath": "./widgets/main/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/main/dist/index.html",
        "widgets/main/dist/assets/**",
        "widgets/main/dist/config.json",
        "widgets/main/dist/geistMono/**",
        "widgets/main/README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": [
          {
            "urlRegex": ".*localhost:8085.*",
            "duration": 0
          }
        ]
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "shutdown",
            "argsRegex": "^/[as]$"
          },
          {
            "program": "explorer",
            "argsRegex": "^ms-settings:network-status$"
          },
          {
            "program": "cmd",
            "argsRegex": "^/c type %LOCALAPPDATA%\\\\overline-updates\\\\status\\.json$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "34px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "system-stats",
      "htmlPath": "./widgets/system-stats/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/system-stats/dist/index.html",
        "widgets/system-stats/dist/assets/**",
        "widgets/system-stats/dist/config.json",
        "widgets/system-stats/dist/geistMono/**",
        "widgets/system-stats/README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "4px",
          "width": "400px",
          "height": "400px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "script-launcher",
      "htmlPath": "./widgets/script-launcher/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/script-launcher/dist/index.html",
        "widgets/script-launcher/dist/assets/**",
        "widgets/script-launcher/dist/config.json",
        "widgets/script-launcher/dist/geistMono/**",
        "widgets/script-launcher/README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "shutdown",
            "argsRegex": "^/[sra]( /t [0-9]{1,5})?$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "400px",
          "height": "400px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "config-widget",
      "htmlPath": "./widgets/config-widget/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": true,
      "focused": true,
      "resizable": true,
      "transparent": true,
      "includeFiles": [
        "widgets/config-widget/dist/index.html",
        "widgets/config-widget/dist/assets/**",
        "widgets/config/dist/config-widget.json",
        "widgets/config/dist/geistMono/**",
        "widgets/config-widget/README.md"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "center",
          "offsetX": "0px",
          "offsetY": "4px",
          "width": "1100px",
          "height": "720px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "calendar",
      "htmlPath": "./widgets/calendar/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/calendar/dist/index.html",
        "widgets/calendar/dist/assets/**",
        "widgets/calendar/dist/geistMono/**"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "54px",
          "width": "300px",
          "height": "420px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "forecast",
      "htmlPath": "./widgets/forecast/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/forecast/dist/index.html",
        "widgets/forecast/dist/assets/**",
        "widgets/forecast/dist/geistMono/**"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": [
          {
            "urlRegex": ".*(open-meteo|ipapi)..*",
            "duration": 0
          }
        ]
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "54px",
          "width": "260px",
          "height": "290px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "update-panel",
      "htmlPath": "./widgets/update-panel/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/update-panel/dist/index.html",
        "widgets/update-panel/dist/assets/**",
        "widgets/update-panel/dist/geistMono/**"
      ],
      "privileges": {
        "shellCommands": [
          {
            "program": "cmd",
            "argsRegex": "^/c (echo %LOCALAPPDATA%|type [A-Za-z]:\\\\Users\\\\[A-Za-z0-9_][A-Za-z0-9_ .-]*\\\\AppData\\\\Local\\\\overline-updates\\\\(status\\.json|ignore\\.json|run-[a-z0-9]{1,10}\\.log))$"
          },
          {
            "program": "pwsh",
            "argsRegex": "^-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File [A-Za-z]:\\\\Users\\\\[A-Za-z0-9_][A-Za-z0-9_ .-]*\\\\AppData\\\\Local\\\\overline-updates\\\\engine\\\\(apply|check|ignore)\\.ps1( .*)?$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "8px",
          "offsetY": "54px",
          "width": "360px",
          "height": "520px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "power",
      "htmlPath": "./widgets/power/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/power/dist/index.html",
        "widgets/power/dist/assets/**",
        "widgets/power/dist/geistMono/**"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          {
            "program": "shutdown",
            "argsRegex": "^/[sr] /t 0$"
          },
          {
            "program": "rundll32",
            "argsRegex": "^user32\\.dll,LockWorkStation$"
          },
          {
            "program": "pwsh",
            "argsRegex": "^-NoProfile -NonInteractive -Command Add-Type -AssemblyName System\\.Windows\\.Forms; \\[void\\]\\[System\\.Windows\\.Forms\\.Application\\]::SetSuspendState\\('Suspend', \\$false, \\$false\\)$"
          }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_right",
          "offsetX": "-8px",
          "offsetY": "54px",
          "width": "220px",
          "height": "250px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "stats-graph",
      "htmlPath": "./widgets/stats-graph/dist/index.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": [
        "widgets/stats-graph/dist/index.html",
        "widgets/stats-graph/dist/assets/**",
        "widgets/stats-graph/dist/geistMono/**"
      ],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "8px",
          "offsetY": "54px",
          "width": "420px",
          "height": "360px",
          "monitorSelection": {
            "type": "primary"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}